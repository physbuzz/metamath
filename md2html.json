{
  "input": "src",
  "output": "html",
  "output_mode": "site",
  "assets": "shared",
  "parse_liquid": false,
  "commands": {
    "mm": "metamath 'read \"'{source}'\"' 'verify proof *' exit",
    "metamath": "metamath 'read \"'{source}'\"' 'verify proof *' exit"
  },
  "math": {
    "backend": "mathjax-chtml",
    "chtml_fonts": "inline"
  },
  "site": {
    "title": "Metamath"
  },
  "feed": false,
  "frontmatter": {
    "layout": "book",
    "render_with_liquid": false,
    "show_title": false
  }
}
