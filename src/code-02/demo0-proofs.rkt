#lang sicp
;; This file was entirely AI generated by fable 5.2.
;; demo0.mm with two extra arguments per statement: a proof tree and a
;; depth budget. The query system is still unmodified.
(#%require "query.rkt" "mm.rkt")

;; (typecode expression proof budget). A rule's proof is its label applied
;; to the proofs of its mandatory hypotheses, in Metamath's order. Its
;; budget is (s ?n) where the hypotheses get ?n.
(add! '(rule (wff (?P -> ?Q) (wim ?wp ?wq) (s ?n))
             (and (wff ?P ?wp ?n) (wff ?Q ?wq ?n))))
(add! '(rule (wff (?t = ?r) (weq ?pt ?pr) (s ?n))
             (and (term ?t ?pt ?n) (term ?r ?pr ?n))))
(add! '(rule (term (?t + ?r) (tpl ?pt ?pr) (s ?n))
             (and (term ?t ?pt ?n) (term ?r ?pr ?n))))
(add! '(rule (term 0 tze (s ?n))))
;; mp tries its essential hypotheses first, major premise before minor.
(add! '(rule (⊢ ?Q (mp ?wp ?wq ?min ?maj) (s ?n))
             (and (⊢ (?P -> ?Q) ?maj ?n) (⊢ ?P ?min ?n)
                  (wff ?P ?wp ?n) (wff ?Q ?wq ?n))))
(add! '(rule (⊢ ((?t = ?r) -> ((?t = ?s) -> (?r = ?s))) (a1 ?pt ?pr ?ps) (s ?n))
             (and (term ?t ?pt ?n) (term ?r ?pr ?n) (term ?s ?ps ?n))))
(add! '(rule (⊢ ((?t + 0) = ?t) (a2 ?pt) (s ?n))
             (term ?t ?pt ?n)))

;; Hypothesis tt of th1. A bodiless rule, since the budget is a variable.
(add! '(rule (term t tt (s ?n))))

;; Megill's proof of th1 as a tree. Postorder traversal gives his proof.
(define megill
  '(mp (weq (tpl tt tze) tt)
       (weq tt tt)
       (a2 tt)
       (mp (weq (tpl tt tze) tt)
           (wim (weq (tpl tt tze) tt) (weq tt tt))
           (a2 tt)
           (a1 (tpl tt tze) tt tt))))
(display (flatten-proof megill)) (newline) (newline)

;; 1. What does this proof prove? Proof given, statement and budget open.
(show 5 (list '⊢ '?what megill '?n))

;; 2. Check a proof against a statement it does not prove.
(show 5 (list '⊢ '(t = 0) megill '?n))

;; 3. Enumerate theorems: statement and proof open, budget given.
(show 3 (list '⊢ '?what '?proof (peano 2)))
(define (count-theorems depth)
  (length (stream-head (run-query (list '⊢ '?what '?proof (peano depth)))
                       100000)))
(display "theorems within depth 2, 3, 4: ")
(display (map count-theorems '(2 3 4))) (newline) (newline)

;; 4. Find a proof: statement given, proof open, budget 1, 2, 3, ...
(define before (applications))
(define found
  (deepen (lambda (budget) (list '⊢ '(t = t) '?proof budget)) 8))
(define proof (caddr (cadr found)))
(display "depth ") (display (car found))
(display ", rule applications ") (display (- (applications) before)) (newline)
(show-tree proof)
(display (flatten-proof proof)) (newline)
(display "same as Megill's proof: ") (display (equal? proof megill)) (newline)
